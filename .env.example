# Copie ce fichier en .env et remplis ce que tu as.

# Clé API Claude (https://console.anthropic.com) : obligatoire pour les résumés, scores et messages.
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5).
JOBBYS_MODEL=claude-opus-5-5

# France Travail : crée une application sur https://francetravail.io et abonne-la à l'API « Offres d'emploi v2 ».
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna : clés gratuites sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Welcome to the Jungle (lecture du site, sans clé).
ENABLE_WTTJ=true
# Offres LinkedIn publiques (lecture seule, sans ton compte). Désactivé par défaut.
ENABLE_LINKEDIN=false

# Envoi des candidatures par email. Avec Gmail : SMTP_PASSWORD est un « mot de passe d'application »
# (https://myaccount.google.com/apppasswords), pas ton mot de passe habituel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Tant que c'est true, les emails sont rédigés mais PAS envoyés. Passe à false quand tu es prêt.
EMAIL_DRY_RUN=true
